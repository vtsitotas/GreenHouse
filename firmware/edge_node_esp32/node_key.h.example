#pragma once
// ── Per-sensor AppKey ──────────────────────────────────────────────────────────
// Generated by `pi/tools/provision_sensor.py --mac <this board's MAC>`, which
// prints a path like `node_key-206EF16C9DB0.h` -- copy (rename) that file to
// "node_key.h" in this same folder, then compile and flash. node_key.h is
// gitignored (see .gitignore, same pattern as GreenhouseSecrets/secrets.h) --
// it never gets committed, since it IS the sensor's real key.
//
// This placeholder (all zeros) lets the sketch compile before a board has
// been provisioned. Flashing with it is not a security problem -- a sensor
// with this key can never complete enrolment (the Pi's copy will never
// match), it just won't work until you swap in the real one.
#include <stdint.h>
static const uint8_t NODE_APP_KEY[16] = {
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
};
