.superpowers/
app/build/
__pycache__/

# Real WiFi/MQTT credentials -- firmware/libraries/GreenhouseSecrets/secrets.h.example
# is the tracked template; each deployment fills in its own secrets.h here.
firmware/libraries/GreenhouseSecrets/secrets.h

# Real per-sensor AppKeys -- node_key.h.example in each edge sketch folder is
# the tracked placeholder; pi/tools/provision_sensor.py's output replaces it
# here, one board at a time, and must never be committed.
firmware/edge_node_esp32/node_key.h
firmware/edge_node_esp32_c3/node_key.h

# provision_sensor.py's own output directory (QR PNGs + node_key-<mac>.h
# headers) -- real per-sensor keys, same reasoning as node_key.h above.
provisioning/

# Scratch / staging
_dart_staging/
deleted/

# SD-card images (large binaries — keep out of git)
*.img
*.img.gz
*.zip

# Logs
*.log

# Flutter local state
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies

# Android Gradle build output (separate tree from Flutter's own app/build/)
app/android/build/
app/android/app/build/
app/android/.gradle/

# Git worktrees (scratch, not tracked)
.worktrees/
firmware/test/host/layout_vectors
firmware/test/host/layout_vectors.exe
