[Unit]
Description=Greenhouse Serial Bridge (UART link to bridge_esp32, replaces the WiFi/MQTT/TLS uplink)
After=network.target mosquitto.service
Requires=mosquitto.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/pi/greenhouse/scripts/serial_bridge.py
Restart=always
RestartSec=10
User=pi
WorkingDirectory=/home/pi/greenhouse

TimeoutStopSec=15
KillSignal=SIGTERM

# ── Sandboxing ───────────────────────────────────────────────────────────────
# PrivateDevices is deliberately NOT set here (unlike every sibling service):
# it would replace /dev with a minimal private instance that has no
# /dev/serial0, which is the one thing this service exists to read.
# See greenhouse-cam-bridge.service for why AF_NETLINK stays allowed.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

# The only filesystem write is the security audit log (mesh_auth_failure,
# mesh_replay_dropped, mesh_unenrolled_frame -- pi/shared/security_log.py);
# without this entry every one of those writes failed with EROFS and the
# events survived only in the journal. The leading '-' keeps the unit
# starting even if install.sh has not created the file yet.
ReadWritePaths=-/var/log/greenhouse-security.log

# Beyond that it only reads/writes the /dev/serial0
# device node and talks to Mosquitto on loopback. Device-node access is governed by Unix group
# membership, not by ProtectSystem=strict's filesystem allowlist -- as long
# as `pi` is in the `dialout` group (the default on Raspberry Pi OS; nothing
# install.sh needs to set up), the kernel already grants this access.
#
# /dev/serial0 only carries real data once the one-time `raspi-config`
# Serial Port step has freed it from the login console -- see INSTRUCTIONS.md.

[Install]
WantedBy=multi-user.target
